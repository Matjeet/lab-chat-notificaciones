# ---------------------------------------------------------------------------
#  Variables de entorno del microservicio chat-notificaciones
# ---------------------------------------------------------------------------
#  Uso:
#    cp .env.example .env      # y ajusta los valores para tu entorno
#
#  - `./gradlew bootRun` carga .env automáticamente (ver build.gradle).
#  - Docker:  docker run --env-file .env chat-notificaciones
#  - Los tests NO usan .env (corren siempre sobre H2 en memoria).
#  - En producción/CI las variables las inyecta el entorno, no este fichero.
#
#  Todas tienen un valor por defecto en application.yml; aquí solo se
#  sobreescriben. El esquema y el usuario se crean con db/bootstrap.sql.
# ---------------------------------------------------------------------------

# --- Base de datos (MySQL centralizada) ---
DB_URL=jdbc:mysql://localhost:3306/chat_notificaciones?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=chat_notificaciones_svc
DB_PASSWORD=chat_notificaciones_pw

# --- JPA / Hibernate ---
# validate = Hibernate solo comprueba el esquema (lo gestiona Flyway).
# Valores posibles: validate | none | update | create | create-drop
JPA_DDL_AUTO=validate

# --- RabbitMQ (consumo del exchange "chat.notificaciones", publicado por chat-conversacion) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# Nombre del exchange (ya existe, lo crea chat-conversacion) y de la cola/binding propios de
# este servicio (ver com.arquetipo.demo.common.config.RabbitMqConfig). Normalmente no hace
# falta tocarlos.
RABBITMQ_NOTIFICACIONES_EXCHANGE=chat.notificaciones
RABBITMQ_NOTIFICACIONES_QUEUE=chat-notificaciones
RABBITMQ_NOTIFICACIONES_ROUTING_KEY=notificacion.#

# --- gRPC saliente hacia chat-registro (valida remitente/receptor con ExisteUsername) ---
REGISTRO_GRPC_HOST=localhost
REGISTRO_GRPC_PORT=9090
